# Copy to backend/.env and fill in. backend/.env is gitignored.
# Only these are read by backend/src — the GOOGLE_* / CLIENT_URL vars
# some older .env files carry over are leftovers from the removed passport code.

PORT=4000

# Read at module scope in src/db/pool.js, so `import 'dotenv/config'` must stay
# the FIRST import in src/index.js. The server refuses to boot if this is unset.
DATABASE_URL=postgresql://USER@localhost:5432/ahnstoppable

# Production on Supabase: use the connection pooler's Session-mode string as
# DATABASE_URL (no ?sslmode=), and set DATABASE_SSL=true. Optionally paste
# Supabase's CA certificate (Project Settings > Database > SSL) into
# DATABASE_CA_CERT to verify the server's certificate; newlines may be written
# as \n. Leave both unset for a local database.
DATABASE_SSL=
DATABASE_CA_CERT=

# Required; the server refuses to boot if unset.
JWT_SECRET=change-me

# Required; comma-separated, split on ',' in src/index.js. Vite defaults to 5173
# but walks forward to 5174/5175 when a port is taken, so all three are listed —
# otherwise the browser gets opaque CORS failures while curl keeps working.
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175

# Invite code required to register a professor account (POST /api/auth/register
# with role=professor). Leave unset to disable professor signup entirely.
PROFESSOR_SIGNUP_CODE=

# Optional sign-in rate limits (per 15 minutes). Failed attempts per account,
# and total sign-in requests per IP address. A class on one school network
# shares an IP, so keep the per-IP number well above class size x a few tries.
# LOGIN_FAILURES_PER_ACCOUNT=8
# LOGIN_REQUESTS_PER_IP=300

# Optional. The class's timezone: decides what "today" is and which day a poll
# or understanding check belongs to. Defaults to America/Los_Angeles.
# APP_TIMEZONE=America/Los_Angeles
