# Copy to backend/.env and fill in. backend/.env is gitignored.
# Only these are read by backend/src — the GOOGLE_* / CLIENT_URL vars
# some older .env files carry over are leftovers from the removed passport code.

PORT=4000

# Read at module scope in src/db/pool.js, so `import 'dotenv/config'` must stay
# the FIRST import in src/index.js. The server refuses to boot if this is unset.
DATABASE_URL=postgresql://USER@localhost:5432/ahnstoppable

# Production on Supabase: use the connection pooler's Session-mode string as
# DATABASE_URL (no ?sslmode=), and set DATABASE_SSL=true. Optionally paste
# Supabase's CA certificate (Project Settings > Database > SSL) into
# DATABASE_CA_CERT to verify the server's certificate; newlines may be written
# as \n. Leave both unset for a local database.
DATABASE_SSL=
DATABASE_CA_CERT=

# Required; the server refuses to boot if unset.
JWT_SECRET=change-me

# Required; comma-separated, split on ',' in src/index.js. Vite defaults to 5173
# but walks forward to 5174/5175 when a port is taken, so all three are listed —
# otherwise the browser gets opaque CORS failures while curl keeps working.
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175

# Invite code required to register a professor account (POST /api/auth/register
# with role=professor). Leave unset to disable professor signup entirely.
PROFESSOR_SIGNUP_CODE=

# Optional sign-in rate limits (per 15 minutes). Failed attempts per account,
# and total sign-in requests per IP address. A class on one school network
# shares an IP, so keep the per-IP number well above class size x a few tries.
# LOGIN_FAILURES_PER_ACCOUNT=8
# LOGIN_REQUESTS_PER_IP=300

# Optional. The class's timezone: decides what "today" is and which day a poll
# or understanding check belongs to. Defaults to America/Los_Angeles.
# APP_TIMEZONE=America/Los_Angeles

# Optional. Enables the AI summary of a day's student questions in the
# Questions card (professor and students; Gemini API). Without it, the
# "Summarize questions" button explains that summaries aren't set up. Create a
# key at https://aistudio.google.com/apikey.
# GEMINI_MODEL picks a different model for summaries (default
#   gemini-3.5-flash-lite). Unset it on the server to use the default.
# GEMINI_FALLBACK_MODEL (none by default) is tried when the main model is
#   rate-limited or overloaded; each model has its own free-tier quota.
# GEMINI_THINKING_LEVEL: minimal | low | medium | high, or "default" to leave it
#   to the model (use "default" for models without thinking levels).
# GEMINI_OVERLOAD_SKIP_SECONDS: after the main model is overloaded, use the
#   fallback model straight away for this long (0 turns it off).
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_FALLBACK_MODEL=none
# GEMINI_THINKING_LEVEL=low
# GEMINI_OVERLOAD_SKIP_SECONDS=300
# SUMMARIES_PER_HOUR=10                  (per person: professor or student)
# STUDENT_SUMMARIES_PER_CLASS_HOUR=12    (all students of a class together)

# Optional. The students' assistant (the button in the bottom-right corner).
# A general AI assistant, always on Gemini 3.5 Flash-Lite (GEMINI_MODEL doesn't
# change it); course help in a class is off until its professor turns it on.
# Uses the same GEMINI_API_KEY. Chats are deleted after
# ASSISTANT_RETENTION_DAYS. Daily caps keep the shared Gemini quota from being
# used up: ASSISTANT_DAILY_CLASS_LIMIT messages per class, and
# ASSISTANT_DAILY_SITE_LIMIT general-help messages across everyone. Messages
# answered with a student's own key don't count.
# ASSISTANT_RETENTION_DAYS=120
# ASSISTANT_DAILY_CLASS_LIMIT=300
# ASSISTANT_DAILY_SITE_LIMIT=300

# Optional. Lets students use their own Google Gemini API key for the
# assistant (stored encrypted, never sent back to the browser).
# Off unless AI_KEY_ENCRYPTION_SECRET is set: 32 random bytes, base64, e.g.
#   openssl rand -base64 32
# Changing the secret makes saved keys unreadable; students then add them again.
# AI_KEY_ENCRYPTION_SECRET=
